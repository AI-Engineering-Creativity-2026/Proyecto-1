PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
VITE_AGICHAT_API_URL=ws://localhost:3000/ws

# Groq: cada integrante usa sus propias credenciales durante el desarrollo local.
GROQ_API_KEY=
GROQ_MODEL=

# TMDB: configura el API Read Access Token y la API Key entregados por TMDB.
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Google Books: una API key compartida por el equipo, sin valores en este archivo.
GOOGLE_BOOKS_API_KEY=

# URL opcional del endpoint compatible con Groq.
GROQ_BASE_URL=

AGENT_TIMEOUT_MS=30000
CLIENT_TIMEOUT_MS=45000

# Caché y presupuesto de los servidores MCP.
MCP_CACHE_TTL_MS=300000
MCP_CACHE_MAX_ENTRIES=500
TMDB_DAILY_REQUEST_LIMIT=900
GOOGLE_BOOKS_DAILY_REQUEST_LIMIT=900

# Servidor MCP de Google Books.
BOOKS_MCP_PORT=3102
GOOGLE_BOOKS_UPSTREAM_TIMEOUT_MS=10000
# Servidor MCP de TMDB.
TMDB_MCP_PORT=3101
TMDB_API_LANGUAGE=es-MX
TMDB_UPSTREAM_TIMEOUT_MS=10000
