{
  "name": "agichat-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "core",
    "ui",
    "sdk"
  ],
  "scripts": {
    "build": "bun --cwd ui build",
    "dev": "bun --cwd server dev",
    "dev:server": "bun --cwd server dev",
    "dev:ui": "bun --cwd ui dev",
    "lint": "bun --cwd ui lint",
    "build:ui": "bun --cwd ui build",
    "lint:ui": "bun --cwd ui lint",
    "test:coverage": "bun --cwd ui test:unit --coverage",
    "test:ui": "bun --cwd ui test:unit",
    "typecheck": "bun --cwd ui type-check",
    "typecheck:ui": "bun --cwd ui type-check"
  }
}
