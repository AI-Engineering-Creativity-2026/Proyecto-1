{
  "name": "agichat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "packages/*",
    "servers/*",
    "widget"
  ],
  "scripts": {
    "build": "bun --cwd server build && bun --cwd widget build",
    "dev": "bun --cwd widget dev",
    "dev:server": "bun --cwd server dev",
    "dev:tmdb-mcp": "bun --cwd servers/tmdb-mcp dev",
    "dev:widget": "bun --cwd widget dev",
    "lint": "bun --cwd widget lint",
    "lint:fix": "bun --cwd widget lint:fix",
    "build:widget": "bun --cwd widget build",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov && bun --cwd widget test:coverage && bun scripts/check-coverage.ts",
    "test:server": "bun --cwd server test",
    "test:widget": "bun --cwd widget test:unit",
    "typecheck": "bun --cwd widget type-check",
    "typecheck:widget": "bun --cwd widget type-check"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
